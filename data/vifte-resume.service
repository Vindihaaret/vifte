[Unit]
Description=Vifte – ta tilbake viftestyringen etter hvilemodus
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
# Først når NVIDIA-driveren er ferdig med å vekke skjermkortet
After=nvidia-resume.service

[Service]
Type=oneshot
# «reload» i stedet for omstart, så ulagrede endringer overlever hvilemodus
ExecStart=-/usr/bin/systemctl reload vifted.service

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
